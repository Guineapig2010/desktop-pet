{
  "name": "albuquerque-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop companion who lives on your screen, chases your cursor and really, really wants you to come to Albuquerque.",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "package:mac": "electron-packager . \"Albuquerque Buddy\" --platform=darwin --overwrite --out=dist --icon=assets/icon.icns --asar.unpack=\"**/*.node\" --asar.unpackDir=src/main/helpers --ignore=\"^/(dist|test|docs)\" --ignore=\"node_modules/@nut-tree-fork/libnut-(linux|win32)\" --app-bundle-id=com.albuquerquebuddy.app --extend-info=assets/Info.extra.plist",
    "test:helper": "node test/e2e/helper-e2e.mjs",
    "install-app": "node scripts/install-mac.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1"
  },
  "optionalDependencies": {
    "@nut-tree-fork/libnut-darwin": "^2.7.5",
    "@nut-tree-fork/libnut-linux": "^2.7.5",
    "@nut-tree-fork/libnut-win32": "^2.7.5"
  }
}

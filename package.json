{
  "name": "albuquerque-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop companion who lives on your screen, chases your cursor and really, really wants you to come to Albuquerque.",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "package:mac": "electron-packager . \"Albuquerque Buddy\" --platform=darwin --overwrite --out=dist --icon=assets/icon.icns --ignore=\"^/(dist|test|docs)\""
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1"
  }
}
